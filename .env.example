# Copie para .env na raiz do projeto. Gere os segredos com: pnpm secrets
# A fase indica quando cada variável passa a ser lida (ver docs/ROADMAP.md).

# ===== API (apps/api) =====
NODE_ENV=development
PORT=3001
# Nº de proxies reversos à frente da API (0 = acesso direto). Na hospedagem
# compartilhada normalmente é 1; sem isso o rate limit enxerga o IP do proxy.
TRUST_PROXY=0

# ===== Banco de dados (MySQL 8 / MariaDB) — fase 1 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=webforge
DB_USER=webforge
DB_PASSWORD=troque-esta-senha
# Hospedagem compartilhada limita conexões por usuário: mantenha baixo
DB_POOL_LIMIT=5

# ===== Sessão e segurança — fase 1 =====
JWT_SECRET=gere-com-pnpm-secrets
# Em produção use o domínio raiz com ponto, ex.: .cliente.com
COOKIE_DOMAIN=localhost
# Origens permitidas (site e painel), separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Administrador inicial: criado no 1º boot SOMENTE se não existir nenhum usuário.
# A senha deve ser trocada no primeiro login. Remova-a depois do primeiro acesso.
ADMIN_EMAIL=admin@exemplo.com
# Mínimo de 10 caracteres
ADMIN_PASSWORD=troque-no-primeiro-login

# ===== Uploads — fase 2 =====
# Caminho relativo parte da raiz do projeto. Em produção, use uma pasta FORA da
# pasta do app (sobrevive a novos deploys)
UPLOAD_DIR=./uploads

# ===== Revalidação do site — fase 2 =====
# URL pública do site, usada pela API para pedir revalidação do cache
WEB_URL=http://localhost:3000
# Segredo compartilhado entre API e site (o mesmo valor nos dois). Sem WEB_URL e
# REVALIDATE_SECRET a API só avisa no log que a revalidação está desligada.
REVALIDATE_SECRET=gere-com-pnpm-secrets

# ===== E-mail (SMTP) — fase 5 =====
# Vazio = e-mails desligados (os formulários continuam gravando). Veja docs/EMAIL.md.
# Gmail: smtp.gmail.com, porta 465, SMTP_SECURE=true e uma senha de app.
SMTP_HOST=
SMTP_PORT=587
# true na porta 465 (TLS direto); false na 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
# Senha de app do provedor, nunca a senha principal da conta
SMTP_PASSWORD=
# Remetente, ex.: Site do Cliente <contato@cliente.com>
MAIL_FROM=

# ===== Site público (apps/web) =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL da API usada pelo servidor do Next.js (pode ser interna) — fase 3
API_INTERNAL_URL=http://localhost:3001
# URL pública da API (imagens e vídeos no HTML do site) — fase 3
API_PUBLIC_URL=http://localhost:3001

# ===== Painel (apps/admin) =====
VITE_API_URL=http://localhost:3001
# URL pública do site, para o link "Ver no site" dos posts (opcional) — fase 4
VITE_SITE_URL=http://localhost:3000
