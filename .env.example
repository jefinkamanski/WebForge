# ===== Banco de dados (MySQL 8 / MariaDB) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=site_platform
DB_USER=site_user
DB_PASSWORD=troque-esta-senha
# Hospedagem compartilhada limita conexões por usuário: mantenha baixo
DB_POOL_LIMIT=5

# ===== API (apps/api) =====
NODE_ENV=development
PORT=3001
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
# Em produção use o domínio raiz com ponto, ex.: .cliente.com
COOKIE_DOMAIN=localhost
# Origens permitidas (site e painel), separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# URL pública do site, usada para pedir revalidação do cache ao Next.js
WEB_URL=http://localhost:3000

# Administrador inicial: criado no 1º boot SOMENTE se não existir nenhum usuário.
# A senha deve ser trocada no primeiro login.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-no-primeiro-login

# ===== Uploads =====
# Em produção, aponte para uma pasta que sobreviva a novos deploys
UPLOAD_DIR=./uploads
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_VIDEO_MB=25

# ===== Site público (apps/web, Next.js) =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL da API usada pelo servidor do Next.js
API_INTERNAL_URL=http://localhost:3001
# Segredo compartilhado entre API e Next.js para revalidação sob demanda
REVALIDATE_SECRET=gere-outro-segredo-longo

# ===== Painel (apps/admin, Vite) =====
VITE_API_URL=http://localhost:3001
