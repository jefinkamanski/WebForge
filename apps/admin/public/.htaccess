# Painel (SPA estática) na hospedagem Apache/LiteSpeed.
# O Vite copia este arquivo para dist/ no build: o deploy é só enviar o dist/.

# Rotas do React: tudo que não for arquivo ou pasta cai no index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Antes do deploy, troque api.cliente.com pela URL da API deste cliente e descomente
  # Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.cliente.com; img-src 'self' data: https://api.cliente.com; media-src https://api.cliente.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # index.html nunca fica em cache (os demais arquivos têm hash no nome)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
