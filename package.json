{
  "name": "WebForge",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma open source para criar sites institucionais com painel administrativo.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm build:shared && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @site/shared build",
    "lint": "eslint .",
    "typecheck": "pnpm build:shared && pnpm -r --if-present typecheck",
    "test": "pnpm build:shared && pnpm -r --if-present test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0"
  },
  "keywords": [],
  "author": "JKDev",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module"
}
